node {
    stage('Checkout & Versioning') {
        checkout scm                            // ✅ 1. Populate workspace first

        def brain = load 'groovy/logic.groovy'  // ✅ 2. Now the file exists
        def appVersion = ""

        appVersion = brain.generateVersion(env.BRANCH_NAME ?: "local")
        brain.logStage("VERSION: ${appVersion}")

        env.APP_VERSION = appVersion            // ✅ Store in env so later stages can use it
    }

    stage('Python Security Audit') {
        sh "python3 scripts/auditor.py"
    }

    stage('Docker Build') {
        sh "docker build -t fastapi-app:${env.APP_VERSION} ."
    }

    stage('Verification') {
        sh "docker run --rm fastapi-app:${env.APP_VERSION} python3 -c 'import fastapi; print(\"FastAPI Ready\")'"
        echo "Build ${env.APP_VERSION} is verified and ready for the world."
    }
}
