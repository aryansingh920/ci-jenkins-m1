pipeline {
    agent any

    stages {

        stage('Checkout & Versioning') {         // 1. Always first
            steps {
                script {
                    checkout scm
                    def brain = load 'ci/groovy/logic.groovy'
                    def version = brain.generateVersion(env.BRANCH_NAME ?: "local")
                    env.APP_VERSION = version
                    brain.logStage("VERSION: ${version}")
                }
            }
        }

        stage('Pre-flight') {                    // 2. Environment sanity check
            steps {
                sh "chmod +x ci/scripts/preflight.sh && ci/scripts/preflight.sh"
            }
        }

        stage('Setup Python Environment') {
            steps {
                sh """
                    apt-get install -y -q python3-pip python3-venv wget apt-transport-https gnupg curl

                    # Install Trivy using modern keyring method (apt-key is removed in Debian trixie)
                    curl -fsSL https://aquasecurity.github.io/trivy-repo/deb/public.key \
                        | gpg --dearmor \
                        | tee /usr/share/keyrings/trivy.gpg > /dev/null

                    echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb generic main" \
                        > /etc/apt/sources.list.d/trivy.list

                    apt-get update -q
                    apt-get install -y -q trivy

                    # Install Python deps
                    python3 -m pip install --quiet --break-system-packages \
                        -r app/requirements.txt \
                        pip-audit pytest pytest-cov httpx
                """
            }
        }

        stage('Python Security Audit') {         // 3. Static file audit (fast, no installs)
            steps {
                sh "python3 ci/scripts/auditor.py"
            }
        }

        

        stage('Dependency Scan') {               // 4. CVE scan (installs pip-audit)
            steps {
                sh "python3 ci/scripts/dep_scanner.py"
            }
        }

        stage('Unit Tests + Coverage') {
            steps {
                sh """
                    cd app && python3 -m pytest test_main.py \
                        --cov=main \
                        --cov-report=term-missing \
                        --cov-fail-under=80 \
                        -v
                """
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -f app/Dockerfile -t fastapi-app:${env.APP_VERSION} app/"
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                    trivy image \
                        --exit-code 0 \
                        --severity HIGH,CRITICAL \
                        --no-progress \
                        --format table \
                        --output trivy-report.txt \
                        fastapi-app:${env.APP_VERSION}

                    echo "=== Trivy Summary ==="
                    cat trivy-report.txt

                    # Now fail if CRITICAL vulns found
                    trivy image \
                        --exit-code 1 \
                        --severity CRITICAL \
                        --no-progress \
                        --quiet \
                        fastapi-app:${env.APP_VERSION}
                """
                archiveArtifacts artifacts: 'trivy-report.txt'
            }
        }

        stage('Verification') {
            steps {
                sh "docker run --rm fastapi-app:${env.APP_VERSION} python3 -c 'import fastapi; print(\"FastAPI Ready\")'"
                echo "Build ${env.APP_VERSION} is verified and ready for the world."
            }
        }

        stage('Build Report') {                  // 8. Last — summarise what actually happened
            steps {
                script {
                    def brain = load 'ci/groovy/reports.groovy'
                    brain.generateReport(
                        env.APP_VERSION,
                        env.BRANCH_NAME ?: "local",
                        true,
                        true
                    )
                    archiveArtifacts artifacts: 'build-report.txt'
                }
            }
        }

        stage('Publish Reports') {
            steps {
                script {
                    def brain = load 'ci/groovy/reports.groovy'
                    brain.publishReports(
                        env.APP_VERSION,
                        '3dac82a1-43d7-4322-974d-fc524598b9a5'  // your existing Jenkins credential ID
                    )
                }
            }
        }

    }

    post {
        always { echo "Pipeline execution finished." }
        failure { echo "The build or deployment failed. Check logs." }
    }
}
