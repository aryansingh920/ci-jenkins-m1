pipeline {
    agent any

    environment {
        // We initialize this here, but we will update it in the first stage
        APP_VERSION = ""
    }

    stages {
        stage('Checkout & Versioning') {
            steps {
                script {
                    checkout scm
                    def brain = load 'ci/groovy/logic.groovy'
                    
                    def version = brain.generateVersion(env.BRANCH_NAME ?: "local")
                    env.APP_VERSION = version          // ✅ set directly, no pre-declaration
                    brain.logStage("VERSION: ${env.APP_VERSION}")
                }
            }
        }

        stage('Python Security Audit') {
            steps {
                // Running terminal commands via the 'sh' step
                sh "python3 ci/scripts/auditor.py"
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -f app/Dockerfile -t fastapi-app:${env.APP_VERSION} app/"
            }
        }

        stage('Verification') {
            steps {
                sh "docker run --rm fastapi-app:${env.APP_VERSION} python3 -c 'import fastapi; print(\"FastAPI Ready\")'"
                echo "Build ${env.APP_VERSION} is verified and ready for the world."
            }
        }
    }

    post {
        always {
            echo "Pipeline execution finished."
        }
        failure {
            echo "The build or deployment failed. Check logs."
        }
    }
}
