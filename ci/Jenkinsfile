pipeline {
    agent any

    stages {
        stage('Checkout & Versioning') {
            steps {
                script {
                    checkout scm
                    def brain = load 'ci/groovy/logic.groovy'
                    def version = brain.generateVersion(env.BRANCH_NAME ?: "local")
                    env.APP_VERSION = version
                    brain.logStage("VERSION: ${version}")   // ✅ use local var, not env
                }
            }
        }

        stage('Python Security Audit') {
            steps {
                sh "python3 ci/scripts/auditor.py"
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -f app/Dockerfile -t fastapi-app:${env.APP_VERSION} app/"
            }
        }

        stage('Verification') {
            steps {
                sh "docker run --rm fastapi-app:${env.APP_VERSION} python3 -c 'import fastapi; print(\"FastAPI Ready\")'"
                echo "Build ${env.APP_VERSION} is verified and ready for the world."
            }
        }
    }

    post {
        always { echo "Pipeline execution finished." }
        failure { echo "The build or deployment failed. Check logs." }
    }
}
